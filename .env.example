# Copy this file to .env. Keep the real key local.
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# ASR_BACKEND accepts funasr, faster-whisper, remote, or the text/json replay adapters.
ASR_BACKEND=funasr
ASR_DEVICE=cpu
ASR_URL=

# Reliability and storage
MODEL_TIMEOUT_SECONDS=45
MODEL_RETRIES=2
WORKER_POLL_SECONDS=0.5
WORKER_LEASE_SECONDS=300
MEETING_DATA_DIR=./data
MEETING_DB=./data/meetings.sqlite3
EMBEDDED_WORKER=true
MAX_UPLOAD_MB=200
AGENT_CHUNK_CHARS=5000

# Optional semantic retrieval. Lexical retrieval works without this extra.
SEMANTIC_ENABLED=false
EMBED_MODEL=BAAI/bge-small-zh-v1.5

# Optional API protection. Leave empty for local development.
API_TOKEN=
